2.1 Bulk RNA & Protein Pathway Scoring Using GSEApy
import gseapy as gp

rna_pathway = gp.ssgsea(
    data=rna_df.T,
    gene_sets=gmt_file,
    sample_norm_method="rank"
).res2d.T

prot_pathway = gp.ssgsea(
    data=protein_df.T,
    gene_sets=gmt_file,
    sample_norm_method="rank"
).res2d.T

# 2.2 scRNA-seq Processing Using Scanpy
import scanpy as sc

adata = sc.AnnData(scrna_counts)
adata.obs = cell_metadata

# QC + normalization
sc.pp.normalize_total(adata)
sc.pp.log1p(adata)

# Highly variable genes
sc.pp.highly_variable_genes(adata, n_top_genes=2000)
adata = adata[:, adata.var.highly_variable]

# PCA + neighbors + clustering
sc.tl.pca(adata)
sc.pp.neighbors(adata)
sc.tl.umap(adata)
sc.tl.leiden(adata)

# 2.3 Cell-Type Annotation 
 sc.tl.rank_genes_groups(adata, 'leiden')

# 2.4 Pseudobulk per Sample × Cell Type
import pandas as pd

pseudobulk = []

for (sample, celltype), idx in adata.obs.groupby(
        ["sample_id", "cell_type"]
    ).groups.items():

    expr = adata[idx].X.mean(axis=0)
    pseudobulk.append([
        sample,
        celltype,
        *expr
    ])

pb_df = pd.DataFrame(
    pseudobulk,
    columns=["sample", "cell_type"] + adata.var_names.tolist()
)

# 2.5 Cell-Type-Specific Pathway Scores
celltype_pathways = {}

for ct in pb_df["cell_type"].unique():

    mat = pb_df[pb_df["cell_type"] == ct] \
        .set_index("sample") \
        .drop(columns="cell_type")

    scores = gp.ssgsea(
        data=mat.T,
        gene_sets=gmt_file
    ).res2d.T

    celltype_pathways[ct] = scores

# 2.6 Cell Composition per Sample
cell_counts = (
    adata.obs
    .groupby(["sample_id", "cell_type"])
    .size()
    .unstack(fill_value=0)
)

cell_frac = cell_counts.div(
    cell_counts.sum(axis=1),
    axis=0
)

# Layer 3 — Cross-Omic Integration
3.1 CNV → RNA → Protein Coupling
common = (
    cnv_df.columns
    .intersection(rna_df.columns)
    .intersection(protein_df.columns)
)

