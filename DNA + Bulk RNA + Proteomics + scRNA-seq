3.5 Multi-Omic Latent Integration
import torch
import torch.nn as nn

X = torch.tensor(
    multi_features.fillna(0).values,
    dtype=torch.float32
)

class AE(nn.Module):
    def __init__(self, d, z=32):
        super().__init__()
        self.enc = nn.Sequential(
            nn.Linear(d, 128),
            nn.ReLU(),
            nn.Linear(128, z)
        )
        self.dec = nn.Sequential(
            nn.Linear(z, 128),
            nn.ReLU(),
            nn.Linear(128, d)
        )

    def forward(self, x):
        z = self.enc(x)
        return self.dec(z), z

model = AE(X.shape[1])
opt = torch.optim.Adam(model.parameters(), 1e-3)

for _ in range(200):
    opt.zero_grad()
    recon, z = model(X)
    loss = nn.MSELoss()(recon, X)
    loss.backward()
    opt.step()

latent = pd.DataFrame(
    z.detach().numpy(),
    index=multi_features.index
)

