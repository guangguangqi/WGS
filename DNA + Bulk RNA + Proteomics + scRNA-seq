for g in common:
    coupling.append({
        "gene": g,
        "cnv_rna": cnv_df[g].corr(rna_df[g]),
        "rna_prot": rna_df[g].corr(protein_df[g]),
        "cnv_prot": cnv_df[g].corr(protein_df[g])
    })

coupling_df = pd.DataFrame(coupling)

3.2 Mutation → Pathway Effects
from scipy.stats import ttest_ind

results = []

for gene in mutation_df.columns:
    mut = mutation_df[gene] > 0

    for p in rna_pathway.columns:
        t, pval = ttest_ind(
            rna_pathway.loc[mut, p],
            rna_pathway.loc[~mut, p],
            nan_policy="omit"
        )

        results.append({
            "gene": gene,
            "pathway": p,
            "p_value": pval
        })

geno_pathway = pd.DataFrame(results)

3.3 RNA ↔ Protein Pathway Concordance
common_p = rna_pathway.columns.intersection(prot_pathway.columns)

concordance = pd.Series({
    p: rna_pathway[p].corr(prot_pathway[p])
    for p in common_p
})

